# ------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit real secrets.
# All values below are placeholders.
# ------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Your Store"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
# Optional. Leave empty for single-server/dev (in-memory rate limiting).
REDIS_URL=

# 32-byte key, base64. Generate: openssl rand -base64 32
# Encrypts secrets saved from Admin > Settings (CAPI token, gateway keys).
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
# Random string for session token hashing. openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_HEX

# --- Initial super admin (used by seed only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-on-first-login

# --- Meta (can also be set in Admin > Marketing > Meta Tracking; DB wins) ---
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# --- Google ---
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GTM_ID=
GOOGLE_ADS_ID=

# --- Payments ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX=true

# --- Couriers ---
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SANDBOX=true
REDX_API_TOKEN=
REDX_SANDBOX=true

# --- Storage (S3-compatible: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_HOST=
STORAGE_PUBLIC_BASE_URL=

# --- Notifications ---
EMAIL_PROVIDER=log            # log | resend
EMAIL_API_KEY=
EMAIL_FROM="Store <no-reply@example.com>"
SMS_PROVIDER=log              # log | http (generic BD SMS gateway, see src/server/notifications/providers.ts)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- AI (optional) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# --- Jobs ---
CRON_SECRET=REPLACE_WITH_RANDOM_HEX

# --- Backups ---
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
